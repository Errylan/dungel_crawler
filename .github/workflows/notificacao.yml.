name: Alerta Discord
on: [push]
jobs:
  notificar:
    runs-on: ubuntu-latest
    steps:
      - name: Enviar Webhook via cURL
        run: |
          curl -H "Content-Type: application/json" \
          -d '{"content": "<@777672689556520991> 🚨 **Novo Commit!**\nO usuário `${{ github.actor }}` enviou novas atualizações para o repositório `${{ github.repository }}`.", "allowed_mentions": { "parse": ["users"] }}' \
          ${{ secrets.DISCORD_WEBHOOK }}
